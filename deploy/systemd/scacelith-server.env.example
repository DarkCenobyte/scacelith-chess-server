# Scacelith dedicated server: environment file of the systemd unit (scacelith-server.service).
#
# Install as /etc/scacelith/scacelith-server.env, owned by root, group scacelith, mode 0640, set
# the values below, then check them as the scacelith account (docs/DEPLOY.md, section 3):
#   sudo -u scacelith env SCACELITH_ENV_FILE=/etc/scacelith/scacelith-server.env /usr/local/bin/scacelith-server check-config
#
# Only the keys an operator must set are here. Every other key keeps its default and is listed,
# with its meaning, in docs/CONFIG.md (and in .env.example); add the ones you change below.
#
# Syntax: this file is read both by systemd (EnvironmentFile=) and by the server
# (SCACELITH_ENV_FILE, for the administration commands). Keep to plain KEY=value lines, comments
# on lines of their own (a "#" after a value is part of the value for systemd), no quotes, no
# backslash (not even in a comment) and no "$". Give secrets as files (KEY_FILE=path).

# Name shown to players (menus, scoresheet "Event"), at most 64 bytes.
SERVER_NAME=Scacelith Community Server

# The DNS name players type in the game. It is used in e-mail links, and Google sign-in only
# works for players who added the server under exactly this name.
SERVER_PUBLIC_HOST=play.example.org

# The state directory of the unit (StateDirectory=scacelith): the SQLite database and the game
# journal. Keep this absolute path, so that the administration commands find the same data.
DATA_DIR=/var/lib/scacelith

# The TLS certificate chain (full chain: the server certificate first, then the intermediates)
# and its private key, as installed by the certbot deploy hook (docs/DEPLOY.md). Both are read
# by the scacelith group; the server reloads them on "systemctl reload" and when they change.
TLS_CERT_FILE=/etc/scacelith/tls/fullchain.pem
TLS_KEY_FILE=/etc/scacelith/tls/privkey.pem

# The master secret (required): a file holding the output of "scacelith-server gen-secret",
# owned by root, group scacelith, mode 0640. Keep a copy apart from the database backups:
# changing it invalidates the recovery codes and, without MFA_ENCRYPTION_KEY, the authenticator
# enrolments of every player.
SERVER_SECRET_FILE=/etc/scacelith/server-secret

# E-mail: account confirmation and password resets. The default transport, "log", writes the
# messages (and their links) to the log: set smtp on a public server. Without e-mail, set
# MAIL_TRANSPORT=none and REQUIRE_EMAIL_VERIFICATION=false instead (no password reset then).
MAIL_TRANSPORT=smtp
MAIL_FROM=Scacelith <no-reply@play.example.org>
SMTP_HOST=smtp.example.org
# 587 with SMTP_SECURITY=starttls (the default), 465 with SMTP_SECURITY=tls.
SMTP_PORT=587
SMTP_USER=no-reply@play.example.org
# A file holding the password alone (root:scacelith, mode 0640).
SMTP_PASSWORD_FILE=/etc/scacelith/smtp-password

# Optional: the anti-cheat engine analysis (docs/ANTICHEAT.md). Empty = engine statistics off.
#ANALYSIS_ENGINE_PATH=/usr/local/bin/stockfish-19
