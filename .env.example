# Scacelith dedicated server configuration.
#
# Generated by tools/gen-env-example.js from src/config.js: do not edit by hand, run `npm run gen:env`.
# Copy this file to .env (next to package.json, or point SCACELITH_ENV_FILE at it) and adjust it;
# real environment variables take precedence over the file. Check the result with
# `node bin/scacelith-server.js check-config`.
#
# Commented-out lines show the default. Lines marked REQUIRED must be set. Secrets may also be
# given as a file: FOO_FILE=/run/secrets/foo (keeps them out of the environment listing).
# Generate a secret with `node bin/scacelith-server.js gen-secret`.

# ================================================================================================
# Server identity and network
# ================================================================================================

# Name shown to players (menus, scoresheet "Event").
# Type: text (at most 64 characters).
# SERVER_NAME=Scacelith Community Server

# Public DNS name of the server, used in e-mail links and the Google SSO redirect URI.
# Type: text.
# SERVER_PUBLIC_HOST=localhost

# Short message of the day shown in the online menu.
# Type: text (at most 200 characters).
# SERVER_MOTD=

# Address the API and WebSocket listeners bind to.
# Type: text.
# BIND_ADDRESS=0.0.0.0

# HTTPS API port (TCP). 44664 is the port of the official server; any free port works for a
# community server.
# Type: port (0-65535).
# API_PORT=44664

# WSS (game WebSocket) port. Empty (the default) = the same port as API_PORT: one TLS listener
# serves the API under /api/v1 and the WebSocket upgrade on /ws. Set another port to split them.
# Type: port (0-65535).
# WS_PORT=

# API port as seen by clients when a proxy/NAT maps ports (0 = API_PORT).
# Type: port (0-65535).
# PUBLIC_API_PORT=0

# WSS port as seen by clients (0 = WS_PORT).
# Type: port (0-65535).
# PUBLIC_WS_PORT=0

# Worker processes (shards) handling connections and games: a number, or "auto" (one per CPU core,
# at most 16).
# Type: text.
# WORKERS=auto

# First shard number of this instance (multi-instance deployments give each instance its own range).
# Type: integer (0-56).
# SHARD_BASE=0

# Free label of this instance in logs and metrics (default: host name).
# Type: text.
# INSTANCE_ID=

# Origin header values allowed to open the game WebSocket (e.g. https://play.example.org). The game
# client sends no Origin; browsers always send one, so they are refused unless listed here.
# Type: comma-separated list.
# WS_ALLOWED_ORIGINS=

# On SIGTERM/SIGINT players are warned (ServerShutdown notice) this long before their connections
# close. Games in progress survive the restart (journal).
# Type: integer (0-120000).
# SHUTDOWN_GRACE_MS=3000

# Linux: every worker binds its own listening socket (SO_REUSEPORT) and the kernel spreads new
# connections, instead of the primary accepting them and handing them out round-robin. Ignored on
# other systems.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# LISTEN_REUSE_PORT=false

# Length of the kernel queue of new connections not yet accepted (listen backlog), which absorbs
# reconnection bursts. The kernel caps it at net.core.somaxconn (Linux), so raise that sysctl as
# well (README, kernel settings).
# Type: integer (128-65535).
# LISTEN_BACKLOG=2048

# Event-loop delay (p99, ms) above which a worker counts as overloaded: new games are then hosted by
# the least loaded worker.
# Type: integer (5-5000).
# SHARD_OVERLOAD_LAG_MS=250

# ================================================================================================
# TLS
# ================================================================================================

# native: this server terminates TLS with TLS_CERT_FILE/TLS_KEY_FILE. proxy: a reverse proxy (nginx,
# haproxy, caddy) terminates TLS and forwards plain HTTP/WebSocket to this server on a private
# address. off: plain text, refused unless ALLOW_INSECURE_DEV=1 (local development only).
# Type: one of native, proxy, off.
# TLS_MODE=native

# PEM certificate chain (fullchain). Reloaded on SIGHUP and when the file changes.
# Type: path (relative to the working directory).
# TLS_CERT_FILE=

# PEM private key. Never commit it.
# Type: path (relative to the working directory).
# TLS_KEY_FILE=

# Oldest TLS version accepted.
# Type: one of TLSv1.2, TLSv1.3.
# TLS_MIN_VERSION=TLSv1.2

# With TLS_MODE=proxy: addresses whose X-Forwarded-For / X-Forwarded-Proto headers are trusted.
# Type: comma-separated list.
# TRUSTED_PROXIES=127.0.0.1,::1

# Allows TLS_MODE=off. Development only; never on a public server.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# ALLOW_INSECURE_DEV=false

# ================================================================================================
# Storage
# ================================================================================================

# Directory for the database, the game journal and runtime sockets.
# Type: path (relative to the working directory).
# DATA_DIR=./data

# SQLite database file (default: DATA_DIR/scacelith.db).
# Type: path (relative to the working directory).
# DB_PATH=

# Append-only journal of the games in progress, replayed after a crash (default: DATA_DIR/journal).
# Type: path (relative to the working directory).
# JOURNAL_DIR=

# Longest time a game event waits in memory before being written to the journal (group commit).
# Type: integer (5-1000).
# JOURNAL_FLUSH_MS=50

# fsync the journal at every flush (survives power loss, not only process crashes). With false, a
# flush that holds a compaction snapshot is still fsynced (with the directory when its segment is
# new), because the segments that snapshot replaces are deleted: a power loss then loses only the
# last records written, never whole games.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# JOURNAL_FSYNC=true

# Journal compaction: once a shard's journal has moved this many 16 MB segments past the oldest
# record a game still needs (its first record, or its latest snapshot), the game, running or waiting
# for its database commit, is written again as one snapshot record and the older segments can be
# deleted. A shard's journal then stays around (this + 1) x 16 MB however long the games last. Lower
# values write more snapshots; higher ones keep more on disk and lengthen the replay after a
# restart.
# Type: integer (1-1000).
# JOURNAL_COMPACT_SEGMENTS=4

# Finished games are committed to the database in batches, at most this long after they end.
# Type: integer (1-2000).
# DB_COMMIT_MS=50

# SQLite page cache of each server process (the primary and every worker), in megabytes.
# Type: integer (2-4096).
# DB_CACHE_MB=64

# Part of the database file read through memory mapping, in megabytes (0 disables it).
# Type: integer (0-65536).
# DB_MMAP_MB=256

# ================================================================================================
# Secrets
# ================================================================================================

# Master secret (at least 32 random bytes, hex or base64). Keys for proof-of-work challenges,
# recovery-code hashing, OAuth state and MFA secret encryption are derived from it with HKDF.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# REQUIRED. Type: secret (at least 32 bytes, hex or base64). Or SERVER_SECRET_FILE=<path>.
SERVER_SECRET=

# Optional separate key (32 bytes) encrypting TOTP secrets at rest. Default: derived from
# SERVER_SECRET. Changing it makes existing TOTP enrolments unreadable.
# Type: secret (at least 32 bytes, hex or base64). Or MFA_ENCRYPTION_KEY_FILE=<path>.
# MFA_ENCRYPTION_KEY=

# ================================================================================================
# Accounts
# ================================================================================================

# Whether new accounts can be created from the game.
# Type: one of open, closed.
# REGISTRATION=open

# Accounts must confirm their e-mail address before playing online.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# REQUIRE_EMAIL_VERIFICATION=true

# Shortest username.
# Type: integer (2-24).
# USERNAME_MIN=3

# Longest username (the scoresheet has room for 24 characters).
# Type: integer (3-24).
# USERNAME_MAX=20

# Shortest password.
# Type: integer (8-64).
# PASSWORD_MIN_LENGTH=10

# A session unused for this long expires.
# Type: integer (1-365).
# SESSION_IDLE_DAYS=30

# A session expires this long after the login, even if used.
# Type: integer (1-730).
# SESSION_MAX_DAYS=90

# Oldest sessions are revoked beyond this number.
# Type: integer (1-100).
# MAX_SESSIONS_PER_USER=10

# ================================================================================================
# Mail
# ================================================================================================

# smtp: send with the SMTP_* settings. log: write the messages to the log (development). none: no
# mail (then e-mail verification and password reset cannot work).
# Type: one of smtp, log, none.
# MAIL_TRANSPORT=log

# Sender address.
# Type: text.
# MAIL_FROM=Scacelith <no-reply@localhost>

# SMTP relay host.
# Type: text.
# SMTP_HOST=

# SMTP port (587 STARTTLS, 465 implicit TLS).
# Type: port (0-65535).
# SMTP_PORT=587

# starttls (required, not opportunistic), tls (implicit, port 465) or none (local relay only).
# Type: one of starttls, tls, none.
# SMTP_SECURITY=starttls

# SMTP user name (empty = no authentication).
# Type: text.
# SMTP_USER=

# SMTP password.
# Type: secretText.
# SMTP_PASSWORD=

# ================================================================================================
# Google single sign-on
# ================================================================================================

# Offers "Sign in with Google" (OpenID Connect, authorization code + PKCE through the system
# browser).
# Type: boolean (true/false, 1/0, yes/no, on/off).
# SSO_GOOGLE_ENABLED=false

# OAuth client ID of a "Web application" client in Google Cloud Console.
# Type: text.
# GOOGLE_CLIENT_ID=

# OAuth client secret. Never commit it.
# Type: secretText.
# GOOGLE_CLIENT_SECRET=

# Authorized redirect URI registered at Google (default:
# https://SERVER_PUBLIC_HOST:PUBLIC_API_PORT/auth/sso/google/callback).
# Type: text.
# GOOGLE_REDIRECT_URI=

# ================================================================================================
# Abuse protection and limits
# ================================================================================================

# Simultaneous players, whole server. Newcomers beyond it are refused at Hello (ServerFull), but a
# player whose game is in progress is still admitted, so that a full server does not make them lose
# it by abandonment. WebSocket upgrades may go max(16, 2 %) beyond it, so that such a player can
# reach Hello.
# Type: integer (>= 1).
# MAX_CONNECTIONS=200000

# Simultaneous WebSocket connections from one IP address (IPv6: per /64).
# Type: integer (>= 1).
# MAX_CONNECTIONS_PER_IP=16

# TLS handshakes in progress per worker (TLS_MODE=native). A new connection takes a slot once the
# first record of its ClientHello has arrived; it has 3 s for that and holds no slot meanwhile. A
# connection beyond this cap, or beyond MAX_PENDING_HANDSHAKES_PER_IP for its address group, is
# closed before any TLS work and the client retries later, so a reconnection storm is served in turn
# instead of every handshake slowing down together. While the server is full, a worker also lets at
# most half this number of new TLS connections per second through.
# Type: integer (2-100000).
# MAX_PENDING_HANDSHAKES=128

# TLS handshakes in progress per worker for one address group: an IPv4 address or an IPv6 /48
# (TLS_MODE=native). Empty (the default) = MAX_PENDING_HANDSHAKES / 32 with a floor of 2, but always
# below MAX_PENDING_HANDSHAKES (4 by default). A value you set must be lower than
# MAX_PENDING_HANDSHAKES, so that a few hosts cannot hold every handshake slot. A worker also keeps
# at most 4 times this number of connections of one group waiting for their ClientHello (and 16
# times MAX_PENDING_HANDSHAKES in total). Raise it when many players share one public address (a
# school or company network); a handshake takes a fraction of a second, so a small value still
# serves many players.
# Type: integer (1-99999).
# MAX_PENDING_HANDSHAKES_PER_IP=

# Largest message a client may send.
# Type: integer (128-65536).
# WS_MAX_MESSAGE_BYTES=512

# Messages per second a client may send (sustained).
# Type: integer (>= 1).
# WS_MSG_RATE=20

# Message burst a client may send.
# Type: integer (>= 1).
# WS_MSG_BURST=40

# Bytes queued for a client that does not read; beyond it the connection is closed (the client
# reconnects and resynchronises).
# Type: integer (>= 4096).
# WS_SEND_BUFFER_LIMIT=262144

# Time a new connection has to authenticate.
# Type: integer (1000-600000).
# WS_HELLO_TIMEOUT_MS=10000

# Server ping interval: each connection gets a ping every half interval to one interval (it also
# measures each player's latency). The game client considers the connection dead after twice this
# (10 s at least) with nothing received.
# Type: integer (>= 1000).
# HEARTBEAT_INTERVAL_MS=10000

# A connection silent for this long is considered dead.
# Type: integer (>= 3000).
# HEARTBEAT_TIMEOUT_MS=30000

# Interval of the game client's own Ping, announced in Welcome (the client measures its round trip
# for the ping indicator and its estimate of the server clock with it). Lower is a more reactive
# ping indicator but costs more server CPU for every connected player: at 2000 these pings alone
# take a third or more of the server CPU of a player in a 3+2 game. After each connection the client
# sends a few quick pings anyway.
# Type: integer (1000-60000).
# CLIENT_PING_INTERVAL_MS=10000

# Largest API request body in bytes.
# Type: integer (>= 1024).
# HTTP_BODY_LIMIT=16384

# API requests per minute from one IP address (all endpoints).
# Type: integer (>= 1).
# HTTP_RATE_PER_IP=120

# Login / register / reset attempts per 10 minutes from one IP address (one IPv6 /64).
# Type: integer (>= 1).
# AUTH_RATE_PER_IP=20

# The AUTH_RATE_PER_IP limits (login / register / reset attempts, and account changes that ask for
# the password), per 10 minutes for one IPv6 /48 as a whole, on top of the limit of each of its /64
# networks: a /48 holds 65536 of them, and one customer often gets a /56 or a /48. 0 means 5 x
# AUTH_RATE_PER_IP. Raise it for a site that brings many players at once over one IPv6 prefix (a
# campus, a club event). IPv4 addresses are only limited one by one.
# Type: integer (>= 0).
# AUTH_RATE_PER_PREFIX=0

# Failed logins on one account before each further attempt is delayed exponentially (up to 15
# minutes).
# Type: integer (>= 1).
# AUTH_FAILURES_PER_ACCOUNT=5

# Proof-of-work difficulty (leading zero bits of SHA-256) required to register; 0 disables it.
# Type: integer (0-26).
# POW_REGISTER_BITS=18

# Proof-of-work difficulty required to log in while the server sees a credential-stuffing wave; 0
# disables it.
# Type: integer (0-26).
# POW_LOGIN_BITS=18

# Failed logins per minute (whole server) that turn on the login proof-of-work. Every failed login
# costs a password hash (about 0.5 s of CPU), so 30 per minute already keeps a quarter of a core
# busy, and a few hundred would need several cores: with PASSWORD_HASH_CONCURRENCY at 1 per worker,
# a small server could never reach such a trigger. Raise it only on a large server where honest
# typos alone come near it.
# Type: integer (>= 1).
# POW_LOGIN_TRIGGER_PER_MIN=30

# Password hashes and verifications (login, registration, password change and reset, account changes
# that ask for the password) that one worker process runs at once. Each costs about 0.5 s of CPU and
# 64-128 MiB in the libuv thread pool; 1 leaves the rest of the core to the games of the worker.
# Keep it below UV_THREADPOOL_SIZE (4 by default) so that the journal and DNS keep free threads: the
# server warns at start (and check-config) when it is not.
# Type: integer (1-64).
# PASSWORD_HASH_CONCURRENCY=1

# Password hashes that may wait for a free slot in one worker process; one more is refused at once
# with 503 server_busy and a Retry-After of 5 to 15 s (0: no waiting at all). One client (an IPv4
# address, or an IPv6 /48) may have at most 2 of them waiting; its next one is refused with 429
# rate_limited.
# Type: integer (>= 0).
# PASSWORD_HASH_QUEUE_MAX=32

# Longest wait for a password hash slot, for all the hashes of one request together (a password
# change hashes twice); the request is then refused with 503 server_busy. At most 13000: the game
# gives up after 15 s, and the hash itself takes a second or two, so that the player sees the "busy"
# answer rather than a timeout.
# Type: integer (100-13000).
# PASSWORD_HASH_QUEUE_TIMEOUT_MS=10000

# ================================================================================================
# Games
# ================================================================================================

# Official time controls (minutes+increment seconds). Each one has its own Elo rating; any other
# time control is "Custom" and never rated.
# Type: comma-separated list.
# RATED_CATEGORIES=1+0,3+0,3+2,5+0,5+3,10+0,10+5,15+10,30+0,30+20,90+30

# Direct challenges and private games may use custom (unrated) time controls.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# ALLOW_CUSTOM_TIME_CONTROLS=true

# A player who does not make their first move in time: the game is aborted (no rating change).
# Type: integer (>= 5000).
# FIRST_MOVE_TIMEOUT_MS=30000

# Shortest time a disconnected player has to come back.
# Type: integer (>= 5000).
# RECONNECT_GRACE_MIN_MS=15000

# Longest time a disconnected player has to come back (the grace is 10% of the base time within
# these bounds).
# Type: integer (>= 5000).
# RECONNECT_GRACE_MAX_MS=60000

# Time both players of a game restored from the journal after a restart or a crash have to come back
# (or the normal grace when it is longer): the server, not the players, broke the connection, and
# every client reconnects at once. The clock of the side to move stays stopped until that player is
# back, for RECOVERY_CLOCK_HOLD_MS at most.
# Type: integer (15000-3600000).
# RECOVERY_GRACE_MS=90000

# After a restart or a crash, the clock (or the first-move timer) of the side to move of a restored
# game does not run until that player is back, and runs again after this long even if they are still
# away. It must be lower than RECOVERY_GRACE_MS. It bounds the free thinking time a player could get
# by staying away on purpose; 0 restarts the clock at the recovery.
# Type: integer (0-3599999).
# RECOVERY_CLOCK_HOLD_MS=20000

# Largest network lag given back on one move.
# Type: integer (0-5000).
# LAG_COMP_MAX_MS=1000

# Lag compensation budget of each player at the start of a game.
# Type: integer (>= 0).
# LAG_QUOTA_INITIAL_MS=2000

# Lag compensation budget regained at every move.
# Type: integer (>= 0).
# LAG_QUOTA_GAIN_MS=100

# Largest lag compensation budget.
# Type: integer (>= 0).
# LAG_QUOTA_MAX_MS=3000

# Draw offers one player may make in a game.
# Type: integer (>= 0).
# DRAW_OFFERS_PER_GAME=3

# A direct challenge expires after this long.
# Type: integer (>= 5000).
# CHALLENGE_TTL_MS=60000

# A private game code expires after this long.
# Type: integer (>= 60000).
# PRIVATE_GAME_TTL_MS=900000

# ================================================================================================
# Matchmaking and ratings
# ================================================================================================

# Rating of a new player in every category.
# Type: integer (100-3000).
# INITIAL_RATING=1500

# Games in a category during which the rating is provisional (K = 40, shown with "?").
# Type: integer (0-100).
# PROVISIONAL_GAMES=30

# Interval between pairing rounds.
# Type: integer (50-5000).
# MATCH_TICK_MS=250

# Largest rating difference accepted right after joining the queue.
# Type: integer (>= 0).
# MATCH_WINDOW_START=100

# Widening of the window at each step.
# Type: integer (>= 0).
# MATCH_WINDOW_STEP=50

# Time between two widenings.
# Type: integer (>= 100).
# MATCH_WINDOW_STEP_MS=5000

# Widest window (reached after about a minute with the defaults).
# Type: integer (>= 0).
# MATCH_WINDOW_MAX=500

# Extra window for a provisional rating (its value is still uncertain).
# Type: integer (>= 0).
# MATCH_PROVISIONAL_BONUS=150

# Rated games two players may be paired for within MATCH_REPEAT_WINDOW_MS by the matchmaker (limits
# rating manipulation between friends).
# Type: integer (>= 1).
# MATCH_REPEAT_LIMIT=3

# See MATCH_REPEAT_LIMIT.
# Type: integer (>= 60000).
# MATCH_REPEAT_WINDOW_MS=3600000

# Abandoned / aborted / no-show games in 24 hours before rated matchmaking is paused for the player
# (15 min, then 1 h, then 6 h).
# Type: integer (>= 1).
# CONDUCT_ABANDON_LIMIT=3

# ================================================================================================
# Anti-cheat and sanctions
# ================================================================================================

# A technically certain cheat (forged protocol, illegal move in a synchronised position, playing out
# of turn) loses the game, disconnects the player and bans them for BAN_DURATION_HOURS.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# AUTO_SANCTION_CERTAIN_CHEATS=true

# Length of an automatic ban.
# Type: integer (1-87600).
# BAN_DURATION_HOURS=24

# UCI engine (Stockfish) used to analyse rated games after they end. Empty: engine-based statistics
# are disabled (timing and reports still count).
# Type: path (relative to the working directory).
# ANALYSIS_ENGINE_PATH=

# Engine processes analysing games (each uses one core, at low priority).
# Type: integer (0-64).
# ANALYSIS_WORKERS=1

# Shallow analysis depth (a weak engine's choice).
# Type: integer (4-30).
# ANALYSIS_DEPTH_FAST=10

# Deep analysis depth (a strong engine's choice).
# Type: integer (6-40).
# ANALYSIS_DEPTH_DEEP=18

# Shorter games are not analysed.
# Type: integer (>= 10).
# ANALYSIS_MIN_PLIES=30

# Reports one player may file per day.
# Type: integer (>= 1).
# REPORTS_PER_DAY=5

# Transposition table of each analysis engine, in MB.
# Type: integer (1-4096).
# ANALYSIS_HASH_MB=32

# Longest search of one position; an engine that exceeds it is restarted and the game is marked
# failed.
# Type: integer (1000-3600000).
# ANALYSIS_POSITION_TIMEOUT_MS=120000

# Interval at which an idle analysis engine looks for new games to analyse.
# Type: integer (100-3600000).
# ANALYSIS_POLL_MS=5000

# Most ordinary games waiting for engine analysis: while this many wait, a newly finished ordinary
# game is not queued (the engines could not catch up anyway). Games with a report, a suspicion
# signal (at most 20 waiting per player) or a moderator request are queued anyway and mostly
# analysed first; one engine claim in four still goes to the oldest ordinary game. 0 analyses only
# those (and then no game feeds the population statistics). At most 100000: the waiting ordinary
# games are counted in every commit of finished games, under the database write lock.
# Type: integer (0-100000).
# ANALYSIS_QUEUE_MAX=5000

# Share of the ordinary rated games queued for analysis (0 to 1, drawn at random when the game
# ends). Lower it when the engine cannot keep up with the games played.
# Type: number (0-1).
# ANALYSIS_SAMPLE_RATE=1

# ================================================================================================
# Observability
# ================================================================================================

# Prometheus metrics and health endpoint (plain HTTP; 0 disables it).
# Type: port (0-65535).
# METRICS_PORT=9464

# Keep it private: 127.0.0.1 or an internal address.
# Type: text.
# METRICS_BIND=127.0.0.1

# Optional bearer token required to read the metrics.
# Type: secret. Or METRICS_TOKEN_FILE=<path>.
# METRICS_TOKEN=

# Log verbosity.
# Type: one of debug, info, warn, error.
# LOG_LEVEL=info

# JSON lines (for log collectors) or readable text.
# Type: one of json, pretty.
# LOG_FORMAT=json

# How client addresses appear in the logs: truncated (IPv4 /24, IPv6 /48), full, or hashed (keyed
# HMAC, rotated daily).
# Type: one of truncated, full, hashed.
# LOG_IP=truncated

# Security events (failed logins, anomalies without sanction) are deleted after this many days.
# Type: integer (>= 1).
# RETENTION_SECURITY_DAYS=90

# Stored IP addresses (sessions, security events) are erased after this many days.
# Type: integer (>= 1).
# RETENTION_IP_DAYS=30

# Interval of the retention purge run by the primary (expired sessions and tokens, old security
# events, anomalies, conduct events and failed analysis jobs, IP erasure). The first run starts
# about a minute after the server starts. At most 2147483647 (about 24.8 days, the longest timer of
# Node.js).
# Type: integer (60000-2147483647).
# RETENTION_INTERVAL_MS=3600000
