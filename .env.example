# Scacelith dedicated server configuration.
#
# Generated by tools/gen-env-example.js from src/config.js: do not edit by hand, run `npm run gen:env`.
# Copy this file to .env (next to package.json, or point SCACELITH_ENV_FILE at it) and adjust it;
# real environment variables take precedence over the file. Check the result with
# `node bin/scacelith-server.js check-config`.
#
# Commented-out lines show the default. Lines marked REQUIRED must be set. Secrets may also be
# given as a file: FOO_FILE=/run/secrets/foo (keeps them out of the environment listing).
# Generate a secret with `node bin/scacelith-server.js gen-secret`.

# ================================================================================================
# Server identity and network
# ================================================================================================

# Name shown to players (menus, scoresheet "Event").
# Type: text (at most 64 characters).
# SERVER_NAME=Scacelith Community Server

# Public DNS name of the server, used in e-mail links and the Google SSO redirect URI.
# Type: text.
# SERVER_PUBLIC_HOST=localhost

# Short message of the day shown in the online menu.
# Type: text (at most 200 characters).
# SERVER_MOTD=

# Address the API and WebSocket listeners bind to.
# Type: text.
# BIND_ADDRESS=0.0.0.0

# HTTPS API port.
# Type: port (0-65535).
# API_PORT=8443

# WSS (game WebSocket) port. May equal API_PORT: the API server then also accepts the WebSocket
# upgrade.
# Type: port (0-65535).
# WS_PORT=8444

# API port as seen by clients when a proxy/NAT maps ports (0 = API_PORT).
# Type: port (0-65535).
# PUBLIC_API_PORT=0

# WSS port as seen by clients (0 = WS_PORT).
# Type: port (0-65535).
# PUBLIC_WS_PORT=0

# Worker processes (shards) handling connections and games: a number, or "auto" (one per CPU core,
# at most 16).
# Type: text.
# WORKERS=auto

# First shard number of this instance (multi-instance deployments give each instance its own range).
# Type: integer (0-56).
# SHARD_BASE=0

# Free label of this instance in logs and metrics (default: host name).
# Type: text.
# INSTANCE_ID=

# Origin header values allowed to open the game WebSocket (e.g. https://play.example.org). The game
# client sends no Origin; browsers always send one, so they are refused unless listed here.
# Type: comma-separated list.
# WS_ALLOWED_ORIGINS=

# On SIGTERM/SIGINT players are warned (ServerShutdown notice) this long before their connections
# close. Games in progress survive the restart (journal).
# Type: integer (0-120000).
# SHUTDOWN_GRACE_MS=3000

# Linux: every worker binds its own listening socket (SO_REUSEPORT) and the kernel spreads new
# connections, instead of the primary accepting them and handing them out round-robin. Ignored on
# other systems.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# LISTEN_REUSE_PORT=false

# Event-loop delay (p99, ms) above which a worker counts as overloaded: new games are then hosted by
# the least loaded worker.
# Type: integer (5-5000).
# SHARD_OVERLOAD_LAG_MS=50

# ================================================================================================
# TLS
# ================================================================================================

# native: this server terminates TLS with TLS_CERT_FILE/TLS_KEY_FILE. proxy: a reverse proxy (nginx,
# haproxy, caddy) terminates TLS and forwards plain HTTP/WebSocket to this server on a private
# address. off: plain text, refused unless ALLOW_INSECURE_DEV=1 (local development only).
# Type: one of native, proxy, off.
# TLS_MODE=native

# PEM certificate chain (fullchain). Reloaded on SIGHUP and when the file changes.
# Type: path (relative to the working directory).
# TLS_CERT_FILE=

# PEM private key. Never commit it.
# Type: path (relative to the working directory).
# TLS_KEY_FILE=

# Oldest TLS version accepted.
# Type: one of TLSv1.2, TLSv1.3.
# TLS_MIN_VERSION=TLSv1.2

# With TLS_MODE=proxy: addresses whose X-Forwarded-For / X-Forwarded-Proto headers are trusted.
# Type: comma-separated list.
# TRUSTED_PROXIES=127.0.0.1,::1

# Allows TLS_MODE=off. Development only; never on a public server.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# ALLOW_INSECURE_DEV=false

# ================================================================================================
# Storage
# ================================================================================================

# Directory for the database, the game journal and runtime sockets.
# Type: path (relative to the working directory).
# DATA_DIR=./data

# SQLite database file (default: DATA_DIR/scacelith.db).
# Type: path (relative to the working directory).
# DB_PATH=

# Append-only journal of the games in progress, replayed after a crash (default: DATA_DIR/journal).
# Type: path (relative to the working directory).
# JOURNAL_DIR=

# Longest time a game event waits in memory before being written to the journal (group commit).
# Type: integer (5-1000).
# JOURNAL_FLUSH_MS=50

# fsync the journal at every flush (survives power loss, not only process crashes).
# Type: boolean (true/false, 1/0, yes/no, on/off).
# JOURNAL_FSYNC=true

# Finished games are committed to the database in batches, at most this long after they end.
# Type: integer (1-2000).
# DB_COMMIT_MS=50

# SQLite page cache of each server process (the primary and every worker), in megabytes.
# Type: integer (2-4096).
# DB_CACHE_MB=64

# Part of the database file read through memory mapping, in megabytes (0 disables it).
# Type: integer (0-65536).
# DB_MMAP_MB=256

# ================================================================================================
# Secrets
# ================================================================================================

# Master secret (at least 32 random bytes, hex or base64). Keys for proof-of-work challenges,
# recovery-code hashing, OAuth state and MFA secret encryption are derived from it with HKDF.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# REQUIRED. Type: secret (at least 32 bytes, hex or base64). Or SERVER_SECRET_FILE=<path>.
SERVER_SECRET=

# Optional separate key (32 bytes) encrypting TOTP secrets at rest. Default: derived from
# SERVER_SECRET. Changing it makes existing TOTP enrolments unreadable.
# Type: secret (at least 32 bytes, hex or base64). Or MFA_ENCRYPTION_KEY_FILE=<path>.
# MFA_ENCRYPTION_KEY=

# ================================================================================================
# Accounts
# ================================================================================================

# Whether new accounts can be created from the game.
# Type: one of open, closed.
# REGISTRATION=open

# Accounts must confirm their e-mail address before playing online.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# REQUIRE_EMAIL_VERIFICATION=true

# Shortest username.
# Type: integer (2-24).
# USERNAME_MIN=3

# Longest username (the scoresheet has room for 24 characters).
# Type: integer (3-24).
# USERNAME_MAX=20

# Shortest password.
# Type: integer (8-64).
# PASSWORD_MIN_LENGTH=10

# A session unused for this long expires.
# Type: integer (1-365).
# SESSION_IDLE_DAYS=30

# A session expires this long after the login, even if used.
# Type: integer (1-730).
# SESSION_MAX_DAYS=90

# Oldest sessions are revoked beyond this number.
# Type: integer (1-100).
# MAX_SESSIONS_PER_USER=10

# ================================================================================================
# Mail
# ================================================================================================

# smtp: send with the SMTP_* settings. log: write the messages to the log (development). none: no
# mail (then e-mail verification and password reset cannot work).
# Type: one of smtp, log, none.
# MAIL_TRANSPORT=log

# Sender address.
# Type: text.
# MAIL_FROM=Scacelith <no-reply@localhost>

# SMTP relay host.
# Type: text.
# SMTP_HOST=

# SMTP port (587 STARTTLS, 465 implicit TLS).
# Type: port (0-65535).
# SMTP_PORT=587

# starttls (required, not opportunistic), tls (implicit, port 465) or none (local relay only).
# Type: one of starttls, tls, none.
# SMTP_SECURITY=starttls

# SMTP user name (empty = no authentication).
# Type: text.
# SMTP_USER=

# SMTP password.
# Type: secretText.
# SMTP_PASSWORD=

# ================================================================================================
# Google single sign-on
# ================================================================================================

# Offers "Sign in with Google" (OpenID Connect, authorization code + PKCE through the system
# browser).
# Type: boolean (true/false, 1/0, yes/no, on/off).
# SSO_GOOGLE_ENABLED=false

# OAuth client ID of a "Web application" client in Google Cloud Console.
# Type: text.
# GOOGLE_CLIENT_ID=

# OAuth client secret. Never commit it.
# Type: secretText.
# GOOGLE_CLIENT_SECRET=

# Authorized redirect URI registered at Google (default:
# https://SERVER_PUBLIC_HOST:PUBLIC_API_PORT/auth/sso/google/callback).
# Type: text.
# GOOGLE_REDIRECT_URI=

# ================================================================================================
# Abuse protection and limits
# ================================================================================================

# Simultaneous WebSocket connections, whole server.
# Type: integer (>= 1).
# MAX_CONNECTIONS=200000

# Simultaneous WebSocket connections from one IP address (IPv6: per /64).
# Type: integer (>= 1).
# MAX_CONNECTIONS_PER_IP=16

# Largest message a client may send.
# Type: integer (128-65536).
# WS_MAX_MESSAGE_BYTES=512

# Messages per second a client may send (sustained).
# Type: integer (>= 1).
# WS_MSG_RATE=20

# Message burst a client may send.
# Type: integer (>= 1).
# WS_MSG_BURST=40

# Bytes queued for a client that does not read; beyond it the connection is closed (the client
# reconnects and resynchronises).
# Type: integer (>= 4096).
# WS_SEND_BUFFER_LIMIT=262144

# Time a new connection has to authenticate.
# Type: integer (>= 1000).
# WS_HELLO_TIMEOUT_MS=10000

# Server ping interval (also measures each player's latency).
# Type: integer (>= 1000).
# HEARTBEAT_INTERVAL_MS=10000

# A connection silent for this long is considered dead.
# Type: integer (>= 3000).
# HEARTBEAT_TIMEOUT_MS=30000

# Largest API request body in bytes.
# Type: integer (>= 1024).
# HTTP_BODY_LIMIT=16384

# API requests per minute from one IP address (all endpoints).
# Type: integer (>= 1).
# HTTP_RATE_PER_IP=120

# Login / register / reset attempts per 10 minutes from one IP address.
# Type: integer (>= 1).
# AUTH_RATE_PER_IP=20

# Failed logins on one account before each further attempt is delayed exponentially (up to 15
# minutes).
# Type: integer (>= 1).
# AUTH_FAILURES_PER_ACCOUNT=5

# Proof-of-work difficulty (leading zero bits of SHA-256) required to register; 0 disables it.
# Type: integer (0-26).
# POW_REGISTER_BITS=18

# Proof-of-work difficulty required to log in while the server sees a credential-stuffing wave; 0
# disables it.
# Type: integer (0-26).
# POW_LOGIN_BITS=18

# Failed logins per minute (whole server) that turn on the login proof-of-work.
# Type: integer (>= 1).
# POW_LOGIN_TRIGGER_PER_MIN=300

# ================================================================================================
# Games
# ================================================================================================

# Official time controls (minutes+increment seconds). Each one has its own Elo rating; any other
# time control is "Custom" and never rated.
# Type: comma-separated list.
# RATED_CATEGORIES=1+0,3+0,3+2,5+0,5+3,10+0,10+5,15+10,30+0,30+20,90+30

# Direct challenges and private games may use custom (unrated) time controls.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# ALLOW_CUSTOM_TIME_CONTROLS=true

# A player who does not make their first move in time: the game is aborted (no rating change).
# Type: integer (>= 5000).
# FIRST_MOVE_TIMEOUT_MS=30000

# Shortest time a disconnected player has to come back.
# Type: integer (>= 5000).
# RECONNECT_GRACE_MIN_MS=15000

# Longest time a disconnected player has to come back (the grace is 10% of the base time within
# these bounds).
# Type: integer (>= 5000).
# RECONNECT_GRACE_MAX_MS=60000

# Largest network lag given back on one move.
# Type: integer (0-5000).
# LAG_COMP_MAX_MS=1000

# Lag compensation budget of each player at the start of a game.
# Type: integer (>= 0).
# LAG_QUOTA_INITIAL_MS=2000

# Lag compensation budget regained at every move.
# Type: integer (>= 0).
# LAG_QUOTA_GAIN_MS=100

# Largest lag compensation budget.
# Type: integer (>= 0).
# LAG_QUOTA_MAX_MS=3000

# Draw offers one player may make in a game.
# Type: integer (>= 0).
# DRAW_OFFERS_PER_GAME=3

# A direct challenge expires after this long.
# Type: integer (>= 5000).
# CHALLENGE_TTL_MS=60000

# A private game code expires after this long.
# Type: integer (>= 60000).
# PRIVATE_GAME_TTL_MS=900000

# ================================================================================================
# Matchmaking and ratings
# ================================================================================================

# Rating of a new player in every category.
# Type: integer (100-3000).
# INITIAL_RATING=1500

# Games in a category during which the rating is provisional (K = 40, shown with "?").
# Type: integer (0-100).
# PROVISIONAL_GAMES=30

# Interval between pairing rounds.
# Type: integer (50-5000).
# MATCH_TICK_MS=250

# Largest rating difference accepted right after joining the queue.
# Type: integer (>= 0).
# MATCH_WINDOW_START=100

# Widening of the window at each step.
# Type: integer (>= 0).
# MATCH_WINDOW_STEP=50

# Time between two widenings.
# Type: integer (>= 100).
# MATCH_WINDOW_STEP_MS=5000

# Widest window (reached after about a minute with the defaults).
# Type: integer (>= 0).
# MATCH_WINDOW_MAX=500

# Extra window for a provisional rating (its value is still uncertain).
# Type: integer (>= 0).
# MATCH_PROVISIONAL_BONUS=150

# Rated games two players may be paired for within MATCH_REPEAT_WINDOW_MS by the matchmaker (limits
# rating manipulation between friends).
# Type: integer (>= 1).
# MATCH_REPEAT_LIMIT=3

# See MATCH_REPEAT_LIMIT.
# Type: integer (>= 60000).
# MATCH_REPEAT_WINDOW_MS=3600000

# Abandoned / aborted / no-show games in 24 hours before rated matchmaking is paused for the player
# (15 min, then 1 h, then 6 h).
# Type: integer (>= 1).
# CONDUCT_ABANDON_LIMIT=3

# ================================================================================================
# Anti-cheat and sanctions
# ================================================================================================

# A technically certain cheat (forged protocol, illegal move in a synchronised position, playing out
# of turn) loses the game, disconnects the player and bans them for BAN_DURATION_HOURS.
# Type: boolean (true/false, 1/0, yes/no, on/off).
# AUTO_SANCTION_CERTAIN_CHEATS=true

# Length of an automatic ban.
# Type: integer (1-87600).
# BAN_DURATION_HOURS=24

# UCI engine (Stockfish) used to analyse rated games after they end. Empty: engine-based statistics
# are disabled (timing and reports still count).
# Type: path (relative to the working directory).
# ANALYSIS_ENGINE_PATH=

# Engine processes analysing games (each uses one core, at low priority).
# Type: integer (0-64).
# ANALYSIS_WORKERS=1

# Shallow analysis depth (a weak engine's choice).
# Type: integer (4-30).
# ANALYSIS_DEPTH_FAST=10

# Deep analysis depth (a strong engine's choice).
# Type: integer (6-40).
# ANALYSIS_DEPTH_DEEP=18

# Shorter games are not analysed.
# Type: integer (>= 10).
# ANALYSIS_MIN_PLIES=30

# Reports one player may file per day.
# Type: integer (>= 1).
# REPORTS_PER_DAY=5

# ================================================================================================
# Observability
# ================================================================================================

# Prometheus metrics and health endpoint (plain HTTP; 0 disables it).
# Type: port (0-65535).
# METRICS_PORT=9464

# Keep it private: 127.0.0.1 or an internal address.
# Type: text.
# METRICS_BIND=127.0.0.1

# Optional bearer token required to read the metrics.
# Type: secret. Or METRICS_TOKEN_FILE=<path>.
# METRICS_TOKEN=

# Log verbosity.
# Type: one of debug, info, warn, error.
# LOG_LEVEL=info

# JSON lines (for log collectors) or readable text.
# Type: one of json, pretty.
# LOG_FORMAT=json

# How client addresses appear in the logs: truncated (IPv4 /24, IPv6 /48), full, or hashed (keyed
# HMAC, rotated daily).
# Type: one of truncated, full, hashed.
# LOG_IP=truncated

# Security events (failed logins, anomalies without sanction) are deleted after this many days.
# Type: integer (>= 1).
# RETENTION_SECURITY_DAYS=90

# Stored IP addresses (sessions, security events) are erased after this many days.
# Type: integer (>= 1).
# RETENTION_IP_DAYS=30
